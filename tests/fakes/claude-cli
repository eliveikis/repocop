#!/bin/sh
# Stands in for the Claude Code CLI's `auth status --json` in tests. Never used by the app itself.
# Reports the same fields as the real CLI: an API key in use appears as apiKeySource.
if [ "$1 $2" != "auth status" ]; then
  echo "fake claude CLI: unsupported command: $*" >&2
  exit 2
fi
if [ -n "$FAKE_CLAUDE_LOGGED_OUT" ]; then
  echo '{"loggedIn": false, "authMethod": "none", "apiProvider": "firstParty"}'
  exit 1
fi
key=""
if [ -n "$FAKE_CLAUDE_KEY_SOURCE" ]; then
  key=", \"apiKeySource\": \"$FAKE_CLAUDE_KEY_SOURCE\""
elif [ -n "$ANTHROPIC_API_KEY" ]; then
  key=', "apiKeySource": "ANTHROPIC_API_KEY"'
elif [ -n "$ANTHROPIC_AUTH_TOKEN" ]; then
  key=', "apiKeySource": "ANTHROPIC_AUTH_TOKEN"'
fi
method="${FAKE_CLAUDE_AUTH_METHOD:-claude.ai}"
printf '{"loggedIn": true, "authMethod": "%s", "apiProvider": "firstParty", "email": "you@example.invalid", "subscriptionType": "max"%s}\n' "$method" "$key"
